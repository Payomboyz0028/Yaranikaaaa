-- 🌐 FAST NETWORK FETCHER (ANTI-CACHE & MULTI-RETRIES)
-- ==============================================================================
local function safeFetch(url)
    local target = url
    if not target:find("%?") then
        target = target .. "?t=" .. tostring(os.time())
    end

    local httpreq = (typeof(request) == "function" and request)
                 or (typeof(http_request) == "function" and http_request)
                 or (typeof(syn) == "table" and typeof(syn.request) == "function" and syn.request)
                 or (http and http.request)

    -- สร้าง fetch ที่มี timeout 8 วินาที ป้องกัน HttpGet block ตลอด
    local function fetchWithTimeout(fetchFn, timeoutSecs)
        local result, done = nil, false
        local thread = task.spawn(function()
            local ok, res = pcall(fetchFn)
            if ok then result = res end
            done = true
        end)
        local elapsed = 0
        while not done and elapsed < timeoutSecs do
            task.wait(0.1)
            elapsed = elapsed + 0.1
        end
        if not done then
            pcall(function() task.cancel(thread) end)
        end
        return result
    end

    for attempt = 1, 3 do
        local res = fetchWithTimeout(function() return game:HttpGet(target) end, 8)
        if type(res) == "string" and #res > 50 and not res:find("404: Not Found") then
            return res
        end

        if httpreq then
            local resObj = fetchWithTimeout(function() return httpreq({ Url = target, Method = "GET" }) end, 8)
            if type(resObj) == "table" and resObj.Body and #resObj.Body > 50 and not resObj.Body:find("404: Not Found") then
                return resObj.Body
            end
        end
        if attempt < 3 then task.wait(0.35) end
    end
    return nil
end

