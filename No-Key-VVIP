-- 🌐 FAST NETWORK FETCHER (ANTI-CACHE & MULTI-RETRIES)
-- ==============================================================================
local function safeFetch(url)
    local target = url
    if not target:find("%?") then
        target = target .. "?t=" .. tostring(os.time())
    end

    local httpreq = (typeof(request) == "function" and request)
                 or (typeof(http_request) == "function" and http_request)
                 or (typeof(syn) == "table" and typeof(syn.request) == "function" and syn.request)
                 or (http and http.request)

    for attempt = 1, 3 do
        local ok, res = pcall(game.HttpGet, game, target)
        if ok and type(res) == "string" and #res > 50 and not res:find("404: Not Found") then
            return res
        end

        if httpreq then
            local okReq, resObj = pcall(httpreq, { Url = target, Method = "GET" })
            if okReq and resObj and resObj.Body and #resObj.Body > 50 and not resObj.Body:find("404: Not Found") then
                return resObj.Body
            end
        end
        task.wait(0.35)
    end
    return nil
end

