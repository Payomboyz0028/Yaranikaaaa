-- ==============================================================================
-- PayomboyZ Hub - Stage 0: Public GitHub Entry Bootstrapper
-- URL: https://raw.githubusercontent.com/Payomboyz0028/Yaranikaaaa/refs/heads/main/Start
-- Description: สคริปต์หน้าแรกสำหรับรันบน GitHub เพื่อเชื่อมต่อไปยัง FlowAuth Log-In / Start2.txt
-- ==============================================================================

if not game:IsLoaded() then
    game.Loaded:Wait()
end

-- 1. ตั้งค่า Key กลางสำหรับ FlowAuth (ใช้ส่งผ่านพารามิเตอร์เท่านั้น ไม่ทับ script_key ของผู้เล่น)
local FLOWAUTH_KEY = "1HSDmI2yqaqA1ayodDaUysDNoKPA"
local FLOWAUTH_LOGIN_URL = "https://flowauth.net/v1/loaders/2f15198975f2ad481c5662d42ed211ed.lua"
local GITHUB_START_FALLBACK = "https://raw.githubusercontent.com/Payomboyz0028/Yaranikaaaa/refs/heads/main/Start"

-- บันทึกคีย์ที่ผู้เล่นกรอกมาจากตัวรัน (เช่น Luarmor Key หรือ VVIP Key) เก็บไว้ไม่ให้หาย
pcall(function()
    local realUserKey = (getgenv and getgenv().script_key) 
                     or _G.script_key 
                     or shared.script_key 
                     or (type(script_key) == "string" and script_key)
                     or ""
    if realUserKey ~= "" and realUserKey ~= FLOWAUTH_KEY then
        if getgenv then getgenv().PayomboyZ_UserKey = realUserKey end
        _G.PayomboyZ_UserKey = realUserKey
    end
end)

-- 2. ฟังก์ชันโหลด Start2.txt (เช็คไฟล์เครื่องก่อน -> ถ้าไม่มีโหลดผ่าน FlowAuth -> ถ้าติดขัดโหลดจาก GitHub)
local loaded = false

-- Step 1: หากกำลังเทสต์ในเครื่อง ให้โหลดไฟล์ Start2.txt ในโฟลเดอร์ workspace ก่อน
pcall(function()
    local localFiles = {
        "Start2.txt",
        "start2.txt",
        "Start.txt",
        "start.txt"
    }
    if isfile and readfile then
        for _, file in ipairs(localFiles) do
            if isfile(file) then
                local content = readfile(file)
                if content and #content > 0 then
                    local fn = loadstring(content)
                    if fn then
                        loaded = true
                        fn(FLOWAUTH_KEY)
                        break
                    end
                end
            end
        end
    end
end)

-- Step 2: โหลดผ่าน FlowAuth Log-In โดยส่ง FlowAuth Key กลางเข้าไป
if not loaded then
    pcall(function()
        local rawCode = game:HttpGet(FLOWAUTH_LOGIN_URL .. "?t=" .. tostring(tick()))
        if rawCode and #rawCode > 0 then
            local fn = loadstring(rawCode)
            if fn then
                loaded = true
                fn(FLOWAUTH_KEY)
            end
        end
    end)
end

-- Step 3: Fallback ไปยัง GitHub Raw กรณี FlowAuth ล่มหรือติดขัด
if not loaded then
    pcall(function()
        local rawCode = game:HttpGet(GITHUB_START_FALLBACK .. "?t=" .. tostring(tick()))
        if rawCode and #rawCode > 0 then
            local fn = loadstring(rawCode)
            if fn then
                loaded = true
                fn(FLOWAUTH_KEY)
            end
        end
    end)
end
