-- ESP Render Loop
bind(RunService.RenderStepped, function()
    local screenSize = Camera.ViewportSize
    local originBottom = Vector2.new(screenSize.X / 2, screenSize.Y - 10)

    for p, esp in pairs(playerDrawings) do
        local char = p.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")

        if S.ESPEnabled and char and hum and root and hum.Health > 0 then
            local dist = (root.Position - Camera.CFrame.Position).Magnitude
            if dist <= S.MaxDist and (not S.TeamCheck or (p.Team == nil or p.Team ~= LocalPlayer.Team)) then
                local rootPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                local headPos = Camera:WorldToViewportPoint(head and head.Position or (root.Position + Vector3.new(0, 1.8, 0)))
                local legPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2.8, 0))

                if onScreen then
                    local height = math.abs(headPos.Y - legPos.Y)
                    local width = height * 0.65
                    local boxX = rootPos.X - width / 2
                    local boxY = headPos.Y

                    local isVis = isPlayerVisible(head)
                    local drawColor = isVis and S.VisibleColor or S.EnemyColor

                    -- Box ESP
                    if S.BoxESP then
                        esp.BoxOutline.Size = Vector2.new(width, height)
                        esp.BoxOutline.Position = Vector2.new(boxX, boxY)
                        esp.BoxOutline.Visible = true

                        esp.Box.Size = Vector2.new(width, height)
                        esp.Box.Position = Vector2.new(boxX, boxY)
                        esp.Box.Color = drawColor
                        esp.Box.Visible = true
                    else
                        esp.BoxOutline.Visible = false
                        esp.Box.Visible = false
                    end

                    -- Tracer
                    if S.Tracers then
                        esp.Tracer.From = originBottom
                        esp.Tracer.To = Vector2.new(rootPos.X, legPos.Y)
                        esp.Tracer.Color = drawColor
                        esp.Tracer.Visible = true
                    else
                        esp.Tracer.Visible = false
                    end

                    -- Head Dot
                    if S.HeadDot and head then
                        esp.HeadDot.Position = Vector2.new(headPos.X, headPos.Y)
                        esp.HeadDot.Color = drawColor
                        esp.HeadDot.Visible = true
                    else
                        esp.HeadDot.Visible = false
                    end

                    -- Health Bar
                    if S.ShowHealth then
                        local hpRatio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        local barWidth = 3
                        local barX = boxX - barWidth - 4

                        esp.HealthBarOutline.Size = Vector2.new(barWidth + 2, height + 2)
                        esp.HealthBarOutline.Position = Vector2.new(barX - 1, boxY - 1)
                        esp.HealthBarOutline.Visible = true

                        local fillH = height * hpRatio
                        esp.HealthBar.Size = Vector2.new(barWidth, fillH)
                        esp.HealthBar.Position = Vector2.new(barX, boxY + height - fillH)
                        esp.HealthBar.Color = Color3.fromHSV(hpRatio * 0.33, 1, 1)
                        esp.HealthBar.Visible = true
                    else
                        esp.HealthBarOutline.Visible = false
                        esp.HealthBar.Visible = false
                    end

                    -- Armor Bar
                    if S.ShowArmor then
                        local armorVal = char:GetAttribute("Armor") or 0
                        local armorRatio = math.clamp(armorVal / 50, 0, 1)
                        if armorVal > 0 then
                            local barWidth = 2
                            local barX = boxX + width + 4
                            local fillH = height * armorRatio
                            esp.ArmorBar.Size = Vector2.new(barWidth, fillH)
                            esp.ArmorBar.Position = Vector2.new(barX, boxY + height - fillH)
                            esp.ArmorBar.Visible = true
                        else
                            esp.ArmorBar.Visible = false
                        end
                    else
                        esp.ArmorBar.Visible = false
                    end

                    -- Name
                    if S.ShowNames then
                        esp.Name.Text = p.DisplayName or p.Name
                        esp.Name.Position = Vector2.new(rootPos.X, boxY - 15)
                        esp.Name.Visible = true
                    else
                        esp.Name.Visible = false
                    end

                    -- Distance
                    if S.ShowDist then
                        esp.Dist.Text = string.format("%dm", math.floor(dist * 0.28))
                        esp.Dist.Position = Vector2.new(rootPos.X, boxY + height + 2)
                        esp.Dist.Visible = true
                    else
                        esp.Dist.Visible = false
                    end

                    -- Weapon Held
                    if S.ShowWeapon then
                        local heldTool = char:FindFirstChildOfClass("Tool")
                        local weaponName = heldTool and (heldTool:GetAttribute("DisplayName") or heldTool.Name) or "None"
                        esp.Weapon.Text = "[" .. weaponName .. "]"
                        esp.Weapon.Position = Vector2.new(rootPos.X, boxY + height + (S.ShowDist and 15 or 2))
                        esp.Weapon.Visible = true
                    else
                        esp.Weapon.Visible = false
                    end

                    -- Chams Highlight
                    if S.Chams then
                        local h = CHAMS_HIGHLIGHTS[p]
                        if not h or h.Parent ~= char then
                            if h then h:Destroy() end
                            h = Instance.new("Highlight")
                            h.Name = "PayomboyZ_Chams"
                            h.FillTransparency = 0.5
                            h.OutlineTransparency = 0
                            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            h.Parent = char
                            CHAMS_HIGHLIGHTS[p] = h
                        end
                        h.FillColor = drawColor
                        h.OutlineColor = Color3.fromRGB(255, 255, 255)
                        h.Enabled = true
                    elseif CHAMS_HIGHLIGHTS[p] then
                        CHAMS_HIGHLIGHTS[p].Enabled = false
                    end
                else
                    for _, d in pairs(esp) do d.Visible = false end
                    if CHAMS_HIGHLIGHTS[p] then CHAMS_HIGHLIGHTS[p].Enabled = false end
                end
            else
                for _, d in pairs(esp) do d.Visible = false end
                if CHAMS_HIGHLIGHTS[p] then CHAMS_HIGHLIGHTS[p].Enabled = false end
            end
        else
            for _, d in pairs(esp) do d.Visible = false end
            if CHAMS_HIGHLIGHTS[p] then CHAMS_HIGHLIGHTS[p].Enabled = false end
        end
    end
end)

