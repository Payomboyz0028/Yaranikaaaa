local function loadPayomboyUI()
    local raw = nil
    local candidates = {
        "UI-SRC-+1.lua",
        "PayomboyZ Hub/UI-SRC-+1.lua",
        "PayomboyUIz_Engine.lua",
    }
    for _, path in ipairs(candidates) do
        if typeof(readfile) == "function" and isfile(path) then
            pcall(function() raw = readfile(path) end)
            if raw and #raw > 0 then break end
        end
    end
    if not raw or #raw == 0 then
        pcall(function()
            raw = game:HttpGet("https://raw.githubusercontent.com/payomboyz333/Library/refs/heads/main/PayomboyUIz")
        end)
    end
    if not raw or #raw == 0 then
        error("[PayomboyZ] Cannot load UI library source!")
    end

    local cleanCode = raw:match("^(.-return%s+library)") or raw
    cleanCode = cleanCode:gsub("Enum%.FontWeight%.Black", "Enum.FontWeight.Bold")
    local fn = loadstring(cleanCode)
    return fn()
end

