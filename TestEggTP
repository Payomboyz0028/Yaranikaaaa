local DRAWINGS = {}
local function newDrawing(dType, props)
    if not Drawing or not Drawing.new then return nil end
    local ok, d = pcall(Drawing.new, dType)
    if not ok or not d then return nil end
    for k, v in pairs(props or {}) do
        pcall(function() d[k] = v end)
    end
    table.insert(DRAWINGS, d)
    return d
end

local CHAMS_HIGHLIGHTS = {}

_G.UrbanReloadCleanup = function()
    for _, c in ipairs(SCRIPT_CONNS) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(SCRIPT_CONNS)
    for _, d in ipairs(DRAWINGS) do
        pcall(function() d:Remove() end)
    end
    table.clear(DRAWINGS)
    for _, h in pairs(CHAMS_HIGHLIGHTS) do
        pcall(function() h:Destroy() end)
    end
    table.clear(CHAMS_HIGHLIGHTS)
    pcall(function()
        local sg = CoreGui:FindFirstChild("PayomboyZ_Urban_UI") or LocalPlayer:FindFirstChild("PlayerGui"):FindFirstChild("PayomboyZ_Urban_UI")
        if sg then sg:Destroy() end
    end)
