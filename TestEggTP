local function instantArmorRefill()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum or hum.Health <= 0 then return end

    local currentArmor = char:GetAttribute("Armor") or 0
    if currentArmor >= 50 then return end

    local kevlar = LocalPlayer.Backpack:FindFirstChild("Kevlar") or char:FindFirstChild("Kevlar")
    if not kevlar then return end

    if kevlar.Parent == LocalPlayer.Backpack then
        hum:EquipTool(kevlar)
        task.wait(0.05)
    end

    if ClientState then
        ClientState.HealItem = "Kevlar"
        ClientState.HealStart = os.clock()
        ClientState.Healing = true
    end

    if HealRemote then
        HealRemote:FireServer()
    end
end

local function instantHealthRefill()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum or hum.Health <= 0 then return end
    if hum.Health >= hum.MaxHealth then return end

    local medkit = LocalPlayer.Backpack:FindFirstChild("Medkit") or char:FindFirstChild("Medkit")
    local item = medkit or LocalPlayer.Backpack:FindFirstChild("Bandage") or char:FindFirstChild("Bandage")
    if not item then return end

    local itemName = item:GetAttribute("Item") or item.Name
    if item.Parent == LocalPlayer.Backpack then
        hum:EquipTool(item)
        task.wait(0.05)
    end

    if ClientState then
        ClientState.HealItem = itemName
        ClientState.HealStart = os.clock()
        ClientState.Healing = true
    end

    if HealRemote then
        HealRemote:FireServer()
    end
end

local function consumeEDrink()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then return end

    local edrink = LocalPlayer.Backpack:FindFirstChild("E-Drink") or char:FindFirstChild("E-Drink")
    if edrink and edrink.Parent == LocalPlayer.Backpack then
        hum:EquipTool(edrink)
        task.wait(0.05)
    end

    if DrinkRemote then
        DrinkRemote:FireServer()
    end
end

