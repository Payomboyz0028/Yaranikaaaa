local BLOCKED_REMOTES = {
    ClientLog = true,
    AntiCheatNotice = true,
    Ban = true,
    Kick = true,
}

if hookmetamethod and getnamecallmethod then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = { ... }

        if (method == "FireServer" or method == "InvokeServer") and typeof(self) == "Instance" then
            if BLOCKED_REMOTES[self.Name] then
                return nil
            end

            -- Silent Aim Headshot Overwrite
            if self == FireRemote and S.AimbotEnabled and S.SilentAim and S.CurrentTarget then
                local tChar = S.CurrentTarget.Character
                local tHead = tChar and tChar:FindFirstChild(S.AimPart or "Head")
                if tChar and tHead then
                    local muzzlePos = args[1] or (LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position)
                    local dir = (tHead.Position - muzzlePos).Unit
                    args[2] = dir                     -- Direction unit
                    args[3] = tChar                   -- Hit target character
                    args[4] = S.AimPart or "Head"     -- Hit part name ("Head")
                    args[5] = tHead.Position          -- Hit world pos
                    args[6] = tHead                   -- Hit part instance
                    args[7] = Enum.Material.Plastic   -- Material
                    args[8] = 1                       -- Penetration factor
                    args[9] = 0                       -- Spread seed = 0
                    args[14] = tHead.Position         -- Target Pos
                    return oldNamecall(self, unpack(args))
                end
            end
        end

        return oldNamecall(self, ...)
    end)
end

